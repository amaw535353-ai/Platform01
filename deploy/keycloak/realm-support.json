{
  "realm": "support",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "clientScopes": [
    {
      "name": "kb:read",
      "description": "Read tenant-scoped knowledge in the synthetic demo",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "platform-api",
      "name": "Platform API resource server",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "platform-ci",
      "name": "Synthetic CI token client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["kb:read"],
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "platform-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice-acme",
      "enabled": true,
      "emailVerified": true,
      "attributes": {"tenant_id": ["acme"]},
      "credentials": [
        {"type": "password", "value": "synthetic-alice-password", "temporary": false}
      ]
    },
    {
      "username": "gina-globex",
      "enabled": true,
      "emailVerified": true,
      "attributes": {"tenant_id": ["globex"]},
      "credentials": [
        {"type": "password", "value": "synthetic-gina-password", "temporary": false}
      ]
    }
  ]
}
